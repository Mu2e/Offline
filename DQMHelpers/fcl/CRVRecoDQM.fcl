# CRV reco DQM: coincidence-cluster and reco-pulse histograms.
#
#   mu2e -c Offline/DQMHelpers/fcl/CRVRecoDQM.fcl -s <rec.art> -n <nevents>
#
# Separate from CRVDQM.fcl because the input tier is different: digi and ROC
# status come off a raw/dig file, coincidence clusters only exist after reco.

#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardServices.fcl"

process_name : CRVRecoDQM

source : {
  module_type : RootInput
  maxEvents   : -1
}

# GeometryService + conditions, needed only by fillSectorMPV. Drop this block
# down to `message` + `TFileService` and set fillSectorMPV : false to run with
# no geometry; the ROC-indexed MPV maps and the cluster spectrum still fill.
services : {
  @table::Services.Reco
  message : @local::default_message
  TFileService : {
    fileName : "crvRecoDQM.root"
  }
}

physics : {
  analyzers : {
    # module label == output directory name
    CRVRecoDQM : {
      module_type              : CRVRecoDQMAnalyzer
      crvCoincidenceClusterTag : "CrvCoincidenceClusterFinder"
      # empty skips the inclusive reco-pulse plots; the cluster ones still fill
      crvRecoPulseTag          : "CrvRecoPulses"
      outputTag                : ""
      diagLevel                : 1
      nBinsPEs                 : 75
      minPEs                   : 0.0
      maxPEs                   : 150.0
      PEfitRangeStart          : 0.7
      PEfitRangeEnd            : 2.0
      PEstart                  : 15.0
      nSectorTypeBins          : 10
      # ~50k per-channel PE spectra; the fit input, not a DQM product
      writePerChannelPE        : false
      # per-event DqmCrv reco-pulse and coincidence-cluster plots
      fillInclusive            : true
      # Inclusive axes that follow the detector. These are the DqmCrv defaults,
      # cut for the full CRV in Mu2e coordinates. On the extracted CRV (y ~ 4237
      # -4649, z ~ 21440-23065) Y and Z are 100% overflow -- move them there.
      nBinsTime                : 100
      minTime                  : 0.0
      maxTime                  : 2000.0
      nBinsTime2               : 100
      minTime2                 : 0.0
      maxTime2                 : 100000.0
      nBinsPos                 : 100
      minX                     : -6904.0
      maxX                     : -904.0
      minY                     : 0.0
      maxY                     : 3000.0
      minZ                     : -3500.0
      maxZ                     : 20000.0
      # needs GeometryService, which the services block above provides
      fillSectorMPV            : true
    }
  }

  ana : [ CRVRecoDQM ]
  end_paths : [ ana ]
}
