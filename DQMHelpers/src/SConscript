#!/usr/bin/env python
# Original author R. Mina.

Import('env')
Import('mu2e_helper')

helper = mu2e_helper(env)

rootlibs = env['ROOTLIBS']

# Subdetector-agnostic DQM core: no detector library belongs on this list.
# Subdetector clients live in their own packages (CRVDQM for the CRV).
helper.make_mainlib([
    'art_Framework_Services_Registry',
    'art_root_io_tfile_support',
    'art_root_io_TFileService',
    'art_Utilities',
    'canvas',
    'MF_MessageLogger',
    'fhiclcpp',
    'fhiclcpp_types',
    'cetlib',
    'cetlib_except',
    rootlibs,
])

