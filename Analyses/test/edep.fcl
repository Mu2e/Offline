# Evaluate the average tracker/calo edep / event and primary energy losses

#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardServices.fcl"

process_name : EDep

services : @local::Services.Reco
services.GeometryService.inputFile: "Offline/Mu2eG4/geom/geom_common.txt"

source: {
  module_type: RootInput
}
services.TFileService.fileName : "nts.owner.edep.version.sequencer.root"


physics : {

  analyzers : {
    EDepAna : {
      module_type              : EdepAna
      CaloShowerStepCollection : "compressDetStepMCs"
      StrawGasStepCollection   : "compressDetStepMCs"
      StepPointMCCollection    : "compressDetStepMCs:virtualdetector"
      Primary                  : "FindMCPrimary"
      # Step counting cuts to approximate hit counts (energies in MeV, times in ns)
      TrkStepEnergyThreshold   : 0.0005
      TrkStepTimeMin           : 500.
      TrkStepTimeMax           : 1.e9
      CaloStepEnergyThreshold  : 0.5
      CaloStepTimeMin          : 500.
      CaloStepTimeMax          : 1.e9
      # Added to step times before folding into the microbunch (ns): nominal proton bunch time, -TimeFromProtonsToDRMarker
      FoldTimeOffset           : -200.
      # Hit-like occupancy windows on the folded (event-window frame) time: the digitization windows,
      # TrackerConditions digitizationStart/End (450, 1705) and CaloReco HitMakerDigitizationStart/End (450, 1795), minus 200 ns
      TrkHitTimeMin            : 250.
      TrkHitTimeMax            : 1505.
      CaloHitTimeMin           : 250.
      CaloHitTimeMax           : 1595.
      DebugLevel               : 0
    }
  }
  EndPath : [ EDepAna ]
  end_paths : [ EndPath ]
}
