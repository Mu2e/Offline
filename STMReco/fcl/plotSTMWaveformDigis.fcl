#
# Plot STMWaveformDigis
#

#include "Offline/fcl/standardServices.fcl"
#include "Offline/STMReco/fcl/prolog.fcl"
#include "Offline/STMReco/fcl/prolog_testbeam.fcl"

process_name: PlotSTMWaveformDigis

source : {
  module_type : RootInput
}

services : {
  @table::Services.Core
  TFileService : { fileName : "stmWaveformDigis.root" }
}

physics: {
  producers : {  }
  filters : {  }
  analyzers : {
  
    plotRawWaveformDigisHPGe : {
      module_type : PlotSTMWaveformDigis
      stmWaveformDigisMapTag : "makeSTMDigis:rawHPGe"
      waveformType : raw
      subtractPedestal : false
      verbosityLevel : 0
      xAxis : "sample_number"
    }

    plotRawWaveformDigisTimeHPGe : {
      module_type : PlotSTMWaveformDigis
      stmWaveformDigisMapTag : "makeSTMDigis:rawHPGe"
      waveformType : raw
      subtractPedestal : false
      verbosityLevel : 0
      xAxis: "waveform_time"
    }
    
    plotZSWaveformDigisHPGe : {
      module_type : PlotSTMWaveformDigis
      stmWaveformDigisMapTag : "makeSTMDigis:zsHPGe"
      waveformType : zs
      plotZSWithoutOffset : true
      subtractPedestal : false
      verbosityLevel : 0
      xAxis : "sample_number"
    }

    plotRawWaveformDigisLaBr : {
      module_type : PlotSTMWaveformDigis
      stmWaveformDigisMapTag : "makeSTMDigis:rawLaBr"
      waveformType : raw
      subtractPedestal : false
      verbosityLevel : 0
      xAxis : "sample_number"
    }
    
    plotZSWaveformDigisLaBr : {
      module_type : PlotSTMWaveformDigis
      stmWaveformDigisMapTag : "makeSTMDigis:zsLaBr"
      waveformType : zs
      subtractPedestal : false
      verbosityLevel : 0
      xAxis : "sample_number"
    }

    plotZSWaveformDigisLaBrUnshifted : {
      module_type : PlotSTMWaveformDigis
      stmWaveformDigisMapTag : "makeSTMDigis:zsLaBr"
      waveformType : zs
      subtractPedestal : false
      verbosityLevel : 0
      xAxis : "sample_number"
      plotZSWithoutOffset : true
    }
     
  }
  # setup paths
  trigger_paths: [  ]
  anaPath : [ plotRawWaveformDigisHPGe, plotRawWaveformDigisTimeHPGe, plotZSWaveformDigisHPGe, plotRawWaveformDigisLaBr, plotZSWaveformDigisLaBr, plotZSWaveformDigisLaBrUnshifted ]
  end_paths: [anaPath]
}

services.ProditionsService.stmEnergyCalib.pedestals : @local::STMTestBeam.Conditions.pedestals
services.ProditionsService.stmEnergyCalib.samplingFrequencies : @local::STMTestBeam.Conditions.samplingFrequencies
